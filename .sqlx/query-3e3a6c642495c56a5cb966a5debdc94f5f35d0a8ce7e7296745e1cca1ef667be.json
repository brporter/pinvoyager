  "query": "SELECT vp.photo_id,\n                  vp.position,\n                  p.captured_at,\n                  p.width,\n                  p.height,\n                  p.variant_status,\n                  p.latitude::float8  AS latitude,\n                  p.longitude::float8 AS longitude\n             FROM voyage_photos vp\n             JOIN photos p ON p.id = vp.photo_id\n            WHERE vp.voyage_id = $1\n            ORDER BY vp.position, vp.photo_id",
