  "query": "SELECT voyage_id,\n                  (array_agg(id ORDER BY position, id)\n                      FILTER (WHERE variant_status = 'ready'))[1] AS photo_id,\n                  bool_or(variant_status = 'pending') AS \"pending!\"\n             FROM photos\n            WHERE voyage_id = ANY($1::uuid[])\n            GROUP BY voyage_id",
