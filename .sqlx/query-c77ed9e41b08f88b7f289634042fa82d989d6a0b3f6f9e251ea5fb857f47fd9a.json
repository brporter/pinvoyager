  "query": "SELECT id, owner_id, title, description, published, granularity,\n                created_at, published_at\n           FROM voyages\n          WHERE published\n            AND published_at IS NOT NULL\n            AND ($1::timestamptz IS NULL OR published_at < $1)\n          ORDER BY published_at DESC\n          LIMIT $2",
