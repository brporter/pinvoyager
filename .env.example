# Copy to .env and adjust. .env is gitignored; this file is not.
#
#   cp .env.example .env
#
# Docker Compose reads .env automatically. For a host-side `cargo run`, export
# it first:  set -a; source .env; set +a
#
# Service configuration is layered: built-in defaults < config.toml <
# PINVOYAGER__-prefixed environment variables. A double underscore separates
# nested keys, so PINVOYAGER__DATABASE__MAX_CONNECTIONS sets database.max_connections.
#
# The committed config.toml already carries development values for everything
# below, so a host-side `cargo run` works without a .env at all. The variables
# are listed here because they are what a deployment sets — and because the
# container image deliberately ships no config.toml, so inside a container the
# environment is the only source.

# ---------------------------------------------------------------------------
# Compose: the PostgreSQL container
# ---------------------------------------------------------------------------

# Role, password, and database created on first boot of the pgdata volume.
# Changing these later has no effect until the volume is removed — see
# docs/running.md. Local development credentials only; nothing here is a secret.
POSTGRES_USER=pinvoyager
POSTGRES_PASSWORD=pinvoyager
POSTGRES_DB=pinvoyager

# Host port for the database. Change it if you already run PostgreSQL locally,
# and change the port in the two URLs below to match.
POSTGRES_PORT=5432

# Host port for the containerised service (`docker compose --profile api up`).
API_PORT=8080

# ---------------------------------------------------------------------------
# Service configuration
# ---------------------------------------------------------------------------

# The only setting with no built-in default: startup fails naming this key if
# neither the file nor the environment supplies it. Points at the Compose
# database as seen from the host, which is what `cargo run` needs — the
# containerised service overrides it in docker-compose.yml with host `db`.
PINVOYAGER__DATABASE__URL=postgres://pinvoyager:pinvoyager@localhost:5432/pinvoyager

# Pool ceiling. Keep it well under the server's own max_connections (100 by
# default) once more than one process shares the database.
PINVOYAGER__DATABASE__MAX_CONNECTIONS=10

# Connections kept warm. 1 is plenty locally; raising it only moves connection
# setup cost off the first request.
PINVOYAGER__DATABASE__MIN_CONNECTIONS=1

# Maximum seconds to wait for a free database connection before returning an error.
PINVOYAGER__DATABASE__ACQUIRE_TIMEOUT_SECS=5

# Listen address. Use 127.0.0.1 on the host; the container image sets
# 0.0.0.0:8080 for itself, since a loopback bind is unreachable from outside a
# container.
PINVOYAGER__SERVER__BIND=127.0.0.1:8080

# How long in-flight requests get to finish after SIGINT/SIGTERM. Under Docker
# this must stay below the container's stop_grace_period, or the drain is cut
# short by SIGKILL and the graceful shutdown is decorative.
PINVOYAGER__SERVER__SHUTDOWN_TIMEOUT_SECS=30

# Per-request timeout, including uploads and queue backpressure.
PINVOYAGER__SERVER__REQUEST_TIMEOUT_SECS=30

# RUST_LOG-style filter directives. A RUST_LOG set in the shell wins over this,
# which is the quick way to turn a single run up to debug.
PINVOYAGER__TELEMETRY__LOG_LEVEL=info,pinvoyager_api=debug,tower_http=debug

# Structured JSON logs (production) vs. human-readable (development).
PINVOYAGER__TELEMETRY__JSON=false

# ---------------------------------------------------------------------------
# Tooling
# ---------------------------------------------------------------------------

# sqlx-cli and the sqlx query macros read DATABASE_URL, not the PINVOYAGER__
# variables. Needed for `sqlx migrate run` and `cargo sqlx prepare`. Keep it in
# sync with PINVOYAGER__DATABASE__URL above.
DATABASE_URL=postgres://pinvoyager:pinvoyager@localhost:5432/pinvoyager

# Compile queries against the committed .sqlx cache instead of a live database.
# The container build sets this itself; set it here only if you want offline
# builds on the host too.
# SQLX_OFFLINE=true

# Development trace exporter (host-side API). Compose sets its own internal URL.
PINVOYAGER__TELEMETRY__OTLP_ENDPOINT=http://127.0.0.1:4318/v1/traces
PINVOYAGER__TELEMETRY__SERVICE_NAME=pinvoyager-api
# Optional Compose host ports; update the host-side exporter URL if 4318 changes.
OTEL_HTTP_PORT=4318
JAEGER_PORT=16686
