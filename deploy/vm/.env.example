# Generate a hex password: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-generated-password
# Optional provider credentials. Register https://pinvoyager.com/auth/google/callback.
# PINVOYAGER__AUTH__PROVIDERS__GOOGLE__CLIENT_ID=
# PINVOYAGER__AUTH__PROVIDERS__GOOGLE__CLIENT_SECRET=
# PINVOYAGER__AUTH__PROVIDERS__GOOGLE__ISSUER=https://accounts.google.com

# Apple website + native iOS sign-in. Configure all provider credentials together.
# The website Services ID is associated with the native App ID in Apple Developer.
# PINVOYAGER__AUTH__PROVIDERS__APPLE__CLIENT_ID=com.pinvoyager
# PINVOYAGER__AUTH__PROVIDERS__APPLE__NATIVE_CLIENT_ID=com.pinvoyager.app
# PINVOYAGER__AUTH__PROVIDERS__APPLE__TEAM_ID=
# PINVOYAGER__AUTH__PROVIDERS__APPLE__KEY_ID=
# PINVOYAGER__AUTH__PROVIDERS__APPLE__PRIVATE_KEY_PEM='-----BEGIN PRIVATE KEY-----
# replace-with-the-existing-signing-key
# -----END PRIVATE KEY-----'
